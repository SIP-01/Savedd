/**
 * SAVEDD — Cloudflare Worker config
 *
 * The worker (worker.ts) serves the static app AND the engine-AI proxy at
 * /api/ai/* — same origin, so no CORS and no key ever reaches a browser.
 *
 * Operator setup (engine-provided AI):
 *   1. wrangler secret put OPENAI_API_KEY      ← OpenAI (or compatible) key
 *      (legacy alias AI_API_KEY is also accepted by the worker)
 *   1b. wrangler secret put BRAVE_API_KEY      ← Brave Search token (never committed)
 *   2. Set the non-secret vars below (OWNER_PUBKEY enables the Admin → AI tab)
 *   3. wrangler deploy
 *
 * Secrets (OPENAI_API_KEY, BRAVE_API_KEY, XAI_API_KEY) must NEVER appear in
 * this file, in "vars", or anywhere in the repo — only in the Worker secret
 * store.
 *
 * Optional — admin-UI-managed config (write the key from the Admin tab
 * instead of env vars): create a KV namespace and uncomment the binding:
 *   wrangler kv namespace create AI_CONFIG_KV
 *
 * Forks: a fresh clone deploys fine with NONE of this — /api/ai/status
 * reports "not configured" and users simply add their own key.
 */
{
  "name": "savedd",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    // Public key (hex) allowed to administer engine AI from Admin → AI.
    // Not a secret. Replace with YOUR pubkey when forking.
    "OWNER_PUBKEY": "c45041618951bb6012ac23f5cdf3d740465f2d640be841fd9bb1d0733370cd3c",
    // Non-secret provider defaults (override per deployment):
    "AI_PROVIDER_ENDPOINT": "https://api.openai.com/v1",
    "AI_MODEL": "gpt-5.6-luna",
    "AI_PROVIDER_NAME": "OpenAI",
    "AI_ENGINE_ENABLED": "true"
  }
  // "kv_namespaces": [
  //   { "binding": "AI_CONFIG_KV", "id": "<paste-id-from-wrangler-kv-namespace-create>" }
  // ]
  //
  // ─── "A Peaceful Goodbye" (memorial video generation) ───
  //   1. wrangler secret put XAI_API_KEY        ← xAI (Grok Imagine) key, never committed
  //   2. wrangler kv namespace create HOMEGOING_JOBS
  //   3. wrangler r2 bucket create savedd-homegoing
  //   4. Uncomment the bindings below and paste the KV id.
  // Without these, /goodbye renders but generation returns 503 — forks stay functional.
  // "kv_namespaces": [
  //   { "binding": "HOMEGOING_JOBS", "id": "<paste-id>" }
  // ],
  // "r2_buckets": [
  //   { "binding": "HOMEGOING_BUCKET", "bucket_name": "savedd-homegoing" }
  // ]
}
